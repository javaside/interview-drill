# 复制为 .env.local 并填入真实值（next dev 自动读取；本文件提交进 git，不含密钥）
DATABASE_URL=postgresql://postgres:dev@localhost:5432/drill
AUTH_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# NextAuth 基路径（v4 机制：path 部分决定 API 基路径）。整站挂 /drill basePath，
# 未设此项时 next-auth 按 http://localhost:3000/api/auth 拼回调——缺 /drill 会 404。
# GitHub OAuth App 回调地址相应填 http://localhost:3000/drill/api/auth/callback/github
NEXTAUTH_URL=http://localhost:3000/drill/api/auth

# 后台 /backstage 管理员白名单（GitHub 数字 id，逗号分隔可多个；空 = 无人可管）
ADMIN_GITHUB_IDS=

# learn 页 AI 问答：每家一组独立环境变量，配哪家用哪家（都不配 = 功能下线，给中文提示）。
# 多家都配了 key 时，可用 AI_PROVIDER 显式指定一家；不指定按表序取第一家。
#   智谱 https://open.bigmodel.cn
ZHIPU_API_KEY=
# ZHIPU_BASE_URL=                # 可选覆盖，默认 https://open.bigmodel.cn/api/paas/v4
# ZHIPU_MODEL=glm-4.7-flash      # 可选覆盖，默认免费档
#   DeepSeek https://platform.deepseek.com
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=             # 可选覆盖，默认 https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
# AI_PROVIDER=zhipu              # zhipu / deepseek
